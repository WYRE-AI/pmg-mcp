{
  "name": "pmg-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Proxmox Mail Gateway REST API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-pmg": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:destructive": "node scripts/lint-destructive-warnings.mjs src",
    "smoke": "node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asachs01/pmg-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "pmg",
    "mail",
    "gateway",
    "proxmox"
  ],
  "author": "Aaron Sachs",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
