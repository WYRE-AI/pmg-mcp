PMG_BASE_URL=https://pmg.example.com:8006
PMG_USERNAME=
PMG_PASSWORD=
PMG_TOOL_TIERS=read
AUTH_MODE=env
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=127.0.0.1
# Required for HTTP: >= 32 chars, not a placeholder (openssl rand -hex 32)
CONDUIT_S2S_SECRET=
MCP_ALLOW_INSECURE_DEV=0
# Extra accepted Host header values for /mcp (comma-separated hostnames, no ports; IPv6 in brackets)
MCP_ALLOWED_HOSTS=
PMG_CA_CERT_FILE=
LOG_LEVEL=info
